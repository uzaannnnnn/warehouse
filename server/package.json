{
  "name": "server",
  "version": "1.0.0",
  "description": "Warehouse backend service",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "node src/server.js",
    "seed:user": "node src/scripts/create-admin.js",
    "seed:users": "node src/scripts/seed-users.js",
    "seed:manager": "npm run seed:users -- --roles=manager",
    "seed:products": "node src/scripts/seed-products.js",
    "seed:raw-materials": "node src/scripts/seed-raw-materials.js",
    "seed:invoices": "node src/scripts/seed-invoices.js",
    "seed:location-stock": "node src/scripts/seed-location-stock.js",
    "seed:all": "npm run seed:users && npm run seed:products && npm run seed:raw-materials && npm run seed:invoices && npm run seed:location-stock",
    "db:clear": "node src/scripts/clear-database.js",
    "test": "echo \"No tests configured\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "nanoid": "^5.1.6",
    "node-fetch": "^2.7.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.2"
  }
}
